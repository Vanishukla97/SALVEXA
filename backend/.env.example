# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=salvexa
DB_SSL=false

# Authentication
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Terms
TERMS_VERSION=v1.0

# Emergency hospitals (OpenStreetMap Overpass API)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
HOSPITAL_RADIUS_KM=10
HOSPITAL_MAX_RESULTS=40
OVERPASS_TIMEOUT_MS=15000

# Emergency SMS delivery
# provider: mock | twilio | fast2sms
SMS_PROVIDER=mock
SMS_FROM_NUMBER=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OpenAI / AI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_PRESCRIPTION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=12000
AI_LOW_CONFIDENCE_THRESHOLD=0.65
OPENAI_VISION_MAX_IMAGE_BYTES=6291456